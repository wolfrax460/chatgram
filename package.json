{
  "name": "chatgram",
  "private": true,
  "version": "1.0.0",
  "description": "Chatgram monorepo — React client for web, Windows (Electron) and Android (Capacitor)",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @chatgram/web",
    "build": "npm run build -w @chatgram/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
