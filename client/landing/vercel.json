{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/app", "destination": "/web/", "permanent": false },
    { "source": "/app/(.*)", "destination": "/web/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/web", "destination": "/web/index.html" },
    { "source": "/web/(.*)", "destination": "/web/index.html" }
  ]
}