# =============================================================================
# Chatgram backend — environment template
# =============================================================================
# Copy to .env on the server and fill in real values:
#     cp .env.example .env && nano .env
#
# .env is git-ignored. NEVER commit real secrets. This file is a TEMPLATE and
# must always contain placeholders only.
# =============================================================================

# ---------------------------------------------------------------- core -------
# production on the server. Enables strict CORS, JSON-only logging and
# "exit non-zero if Mongo is unreachable" behaviour.
NODE_ENV=production

# The Node process listens here. nginx is the ONLY public entry point, so this
# must not be exposed by the firewall.
PORT=5000

# ---------------------------------------------------------------- database ---
# MongoDB Atlas M0. The database name must be at the end (/chatgram).
# IMPORTANT: if the password contains any of @ : / ? # [ ] % it must be
# percent-encoded. Example:  p@ss  ->  p%40ss
MONGODB_URI=mongodb+srv://wolfrax:<db_password>@cluster0.6ik0wiw.mongodb.net/chatgram?retryWrites=true&w=majority

# Optional tuning. Defaults shown.
# MONGODB_MAX_RETRIES=5
# MONGODB_RETRY_DELAY_MS=3000

# ---------------------------------------------------------------- auth ------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The app BREAKS if this is left at the built-in fallback value in production.
JWT_SECRET=<generate-a-48-byte-random-hex-string>
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=<generate-a-DIFFERENT-48-byte-random-hex-string>
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------- cors ------
# The EXACT frontend origin. https, NO trailing slash.
# Must be the production Vercel URL, not a preview URL.
# Wrong value here is the #1 cause of "blocked by CORS policy".
# Multiple origins may be comma-separated (e.g. prod + a preview URL).
CLIENT_URL=https://<your-project>.vercel.app

# ---------------------------------------------------------------- uploads ----
# Where avatars / images / videos / voice notes are written.
#
# Leave the CLOUDINARY_* values EMPTY to store media on this machine's disk
# (server/uploads, or UPLOAD_DIR below). That works, but media then lives only
# on this VM: it is not in database backups and is lost if the instance dies.
#
# Set all three CLOUDINARY_* values to store media on Cloudinary instead. The
# database then holds an absolute https://res.cloudinary.com/... URL and
# nothing is written to this VM's disk. Requires no code change — set the three
# values and restart. See CLOUDINARY-SETUP.md.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder created inside your Cloudinary account.
CLOUDINARY_FOLDER=chatgram

# Only used when Cloudinary is NOT configured.
# UPLOAD_DIR=/home/ubuntu/chatgram/server/uploads

# Max upload size in bytes. nginx `client_max_body_size` must be >= this.
MAX_FILE_SIZE=26214400

# --------------------------------------------------- signup verification -----
# true = an email/phone code must be verified before an account is created.
REQUIRE_VERIFICATION=true
# NEVER true in production: it returns verification codes in the API response.
DEV_SHOW_CODES=false

# ---------------------------------------------------------------- email ------
# console | smtp | resend
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-gmail-address@gmail.com>
# Google App Password (16 chars). Not your normal Gmail password.
SMTP_PASS=<16-character-app-password>
MAIL_FROM=Chatgram <your-gmail-address@gmail.com>

# ---------------------------------------------------------------- sms --------
# console | twilio   (console prints codes to the log; twilio costs money)
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890

# --------------------------------------------------------- google sign-in ----
# Optional. Google only accepts http:// redirect URIs for localhost, so this
# WORKS over HTTPS on the deployed backend — add this exact URI in Google Cloud:
#   https://chatgram.duckdns.org/api/auth/google/callback
GOOGLE_CLIENT_ID=<xxxxxxxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-xxxxxxxx>
GOOGLE_REDIRECT_URI=https://chatgram.duckdns.org/api/auth/google/callback

# ------------------------------------------------------- help & feedback -----
# Every user gets a permanent conversation with this account so they can report
# bugs, ask for help and request changes. It is created automatically on
# startup if it does not exist, and flagged role=admin.
#
# SUPPORT_PASSWORD is only used when the account is first created. Leave it
# empty to skip creating the account.
SUPPORT_EMAIL=support@chatgram.local
SUPPORT_NAME=Chatgram Support
SUPPORT_PASSWORD=<generate-a-strong-password>

# ------------------------------------------------------------ app version ----
# Shown to clients; bump to tell installed apps an update exists.
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
APP_UPDATE_URL=
APP_RELEASE_NOTES=
