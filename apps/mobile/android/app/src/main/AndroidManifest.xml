<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!-- FCM (1.1.7): notification payloads (if the server ever sends one)
             must land on the same high-importance channel as local messages. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|fontScale|locale|layoutDirection|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Chunk 7C: finishes the update download even when the app was closed.
             The system delivers DOWNLOAD_COMPLETE here; exported=false is enough
             (system broadcasts still arrive) and keeps other apps out. -->
        <receiver
            android:name=".UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- FCM (1.1.7): single MESSAGING_EVENT receiver for token refreshes and
             data messages. It extends the Capacitor push plugin's service and
             calls super, so the plugin's JS events keep working, but the library
             declaration is removed below to avoid two services racing for the
             same intent. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <service
            android:name=".ChatgramMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM (1.1.7): "Decline" on an incoming-call notification stops the
             ringtone and removes the notification without opening the app. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Camera / microphone are only requested by the WebView when a call or a
         voice note actually needs them (Capacitor's BridgeWebChromeClient wires
         onPermissionRequest to the Android runtime prompt); both features are
         optional so the app still installs on devices without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Calls: route audio to a paired Bluetooth headset / car kit. On Android
         12+ this is a runtime permission ("Nearby devices"); the legacy pair is
         only needed up to API 30. All are optional features, so a device
         without Bluetooth still installs the app. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Kept for the update notifications in CHUNK 7 and for call alert
         notifications; Android 13+ only shows them after a runtime prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FCM (1.1.7): incoming-call alerts may open the call screen on a locked
         phone. On Android 14+ this is a user-controlled permission inspected with
         NotificationManager.canUseFullScreenIntent(); when denied, the same
         notification is posted as a heads-up alert instead. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Chunk 8: the "messages" notification channel enables vibration, which
         Android only performs when the app holds VIBRATE. Without it the
         notification is silent instead of vibrating. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Chunk 8: lets the app ask Android to exempt it from battery optimization
         (Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS), so the Socket.IO
         connection survives Doze long enough to post local message/call
         notifications. Normal permission: no runtime prompt, the user confirms
         in the system dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Chunk 7C: the in-app updater hands the verified APK to Android's package
         installer. This permission lets the system offer that flow; the user
         still approves "install unknown apps" once and taps Install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The photo/file picker inside the WebView uses the Storage Access
         Framework (ACTION_GET_CONTENT), which needs no storage permission on
         Android 7+, so READ_MEDIA_* / READ_EXTERNAL_STORAGE are intentionally
         NOT declared: fewer scary prompts at install time. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
</manifest>
