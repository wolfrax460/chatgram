{
  "name": "@chatgram/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Chatgram for Windows (Electron shell around the React web client)",
  "main": "main.js",
  "author": "Chatgram",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chatgram.desktop",
    "productName": "Chatgram",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["main.js", "preload.js", "offline.html", "assets/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chatgram"
    },
    "publish": [{ "provider": "github", "owner": "wolfrax460", "repo": "chatgram" }]
  }
}
