{
  "name": "@chatgram/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Chatgram for Windows (Electron shell around the React web client)",
  "main": "main.js",
  "author": "Chatgram",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.chatgram.desktop",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "productName": "Chatgram",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chatgram"
    },
    "artifactName": "chatgram-windows-setup.${ext}",
    "electronDist": "F:/projects/chatgram/node_modules/electron/dist"
  }
}
